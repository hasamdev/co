# Defence in depth for the gated app files.
#
# Primary protection is the guard line inside each app .php file, which
# answers a direct request with 403 on any web server, with no host
# configuration. This file adds an Apache-level block on top; nginx ignores
# it, which is fine — the guard already covers that case.

<IfModule mod_authz_core.c>
	Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
